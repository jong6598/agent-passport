{
  "name": "agent-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vault": "esbuild web/vault.js --bundle --minify --format=iife --target=es2022 --outfile=vault-bundle.js",
    "build:studio": "esbuild web/studio.js --bundle --minify --format=iife --target=es2022 --outfile=studio-bundle.js",
    "build:submit": "esbuild web/submit.js --bundle --minify --format=iife --target=es2022 --outfile=submit-bundle.js",
    "build:publish": "esbuild web/publish.js --bundle --minify --format=iife --target=es2022 --outfile=publish-bundle.js",
    "build:activate": "esbuild web/activate.js --bundle --minify --format=iife --target=es2022 --outfile=activate-bundle.js",
    "build": "npm run build:vault && npm run build:studio && npm run build:submit && npm run build:publish && npm run build:activate",
    "test:vault": "node --test web/key-vault-core.test.js",
    "test:registration": "node --test web/registration-core.test.js shared/self-registration-core.test.js",
    "test:browser": "node web/browser-smoke.js",
    "test:passport": "node web/passport-browser-smoke.js",
    "test:studio": "node web/studio-browser-smoke.js",
    "test:submit": "node web/submit-browser-smoke.js",
    "test:publish": "node web/publish-browser-smoke.js",
    "validate:registration": "node scripts/validate-registration.mjs",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "npm run test:vault && npm run test:registration && npm run build && npm run prepare:dist && npm run release:check"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1"
  }
}
